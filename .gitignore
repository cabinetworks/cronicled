# --- Deny by default: data never enters this repo -----------------------------
# Anything that could carry library contents, credentials or local state is
# ignored wholesale; specific config files are allowed back in below.
*.json
*.jsonl
*.db
*.db-journal
*.sqlite
*.sqlite3
*.tsv
*.csv
*.log
*.err
*.pid
*.key
*.pem
*.crt
*.env
*.sql
*.bak
*.nfo
*.yaml
*.yml
*.ini
*.cfg
*.toml
*.zip
*.tar
*.gz
*.rar
*.parquet

# --- Media: never, under any circumstances ------------------------------------
*.mp4
*.m4v
*.mkv
*.avi
*.wmv
*.mov
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.webm
*.srt
*.vtt
*.ass
*.m3u
*.mp3
*.wav
*.flac
*.bmp
*.tiff
*.heic

# --- Allowed back in ----------------------------------------------------------
# CI workflow definitions are config, not data. Without this the deny-by-default
# *.yml rule silently excludes them: the file survives only while it is already
# tracked, so a fresh clone-and-add drops CI entirely.
!.github/workflows/*.yml
!.github/workflows/*.yaml
# Deliberately narrow. A JSON that genuinely belongs in the repo can be named
# *.example.json; anything else must justify itself by being force-added, which
# the leak guard then catches.
!**/*.example.json
# Project metadata and its lock file are configuration, not data. The negation is
# by exact filename: *.toml stays blocked, because a .toml is a perfectly good
# place for library data to hide.
!pyproject.toml
!uv.lock

# --- Local user config (brand data, endpoints, secrets) -----------------------
# Exclude the directory's CONTENTS, not the directory itself: a negated
# pattern cannot rescue a file inside an excluded directory, because git never
# descends into it to check. Excluding "/config/*" still lets git look inside
# to find the one file the negation lets back through.
/config/*
!/config/*.example.json
/var/

# --- The leak guard's pattern list: never committed (see Task 2) --------------
# It has no extension, so the rules above do not cover it.
.leak-patterns

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# --- OS -----------------------------------------------------------------------
.DS_Store
